{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@zite/*": [
        "./src/__zite__/*"
      ],
      "@app": [
        "./src/App.tsx"
      ],
      "@zite/endpoints-runtime-sdk": [
        "./.zite/types/zite-endpoints-runtime-sdk.d.ts"
      ],
      "zite-endpoints-sdk": [
        "./src/__zite__/sdk.ts"
      ],
      "zite-auth-sdk": [
        "./src/__zite__/auth.ts"
      ],
      "zite-file-upload-sdk": [
        "./src/__zite__/fileUpload.ts"
      ],
      "zite-integrations-backend-sdk": [
        "./src/__zite__/integrations.ts"
      ],
      "zitejs/db": [
        "../../.zite/db.ts"
      ],
      "zitejs/api": [
        "./.zite/api.ts"
      ],
      "zitejs/auth": [
        "../../packages/runtime/auth.tsx"
      ],
      "zitejs/backend": [
        "../../packages/runtime/backend.ts"
      ],
      "zitejs/backend/base": [
        "../../packages/runtime/backend.ts"
      ],
      "zitejs/caller": [
        "../../packages/runtime/caller.ts"
      ],
      "zitejs/runtime": [
        "../../packages/runtime/client.ts"
      ],
      "zitejs/upload": [
        "../../packages/runtime/upload.ts"
      ],
      "zitejs/pdf": [
        "../../packages/runtime/pdf.ts"
      ],
      "zitejs/integrations": [
        "./.zite/integrations/airtable.ts"
      ],
      "zitejs/email": [
        "./.zite/integrations/email.ts"
      ],
      "@project/components/*": [
        "../../packages/components/*"
      ]
    },
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}