# Salin ke .env.local lalu isi nilainya.
#
# Berkas ini untuk server SELF-HOST — tidak ada lagi akun/workspace Zite.
# Dua service memakai berkas ini dengan nilai yang berbeda pada APP_NAME, PORT,
# PUBLIC_BASE_URL, SPA_DIR, UPLOADS_DIR, dan PDF_DIR:
#
#   LearningManagement : APP_NAME=learning-management  PORT=3360  lms.pmp.web.id
#   LearnerPortal      : APP_NAME=learner-portal       PORT=3361  learn.pmp.web.id

# --- Database (PostgreSQL di E:\Data\Database\PostgreSQL) ---
DATABASE_URL=postgres://learning_management_app:RAHASIA@127.0.0.1:5432/learning_management
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=learning_management
PGUSER=learning_management_app
PGPASSWORD=ubah-saya
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=10000

# --- Sesi & akun awal (wajib) ---
# SESSION_SECRET: string acak panjang, mis. hasil `openssl rand -hex 32`.
SESSION_SECRET=ubah-dengan-string-acak-panjang
COOKIE_SECURE=true
# Dibuat otomatis hanya bila tabel AuthUsers masih kosong.
ADMIN_EMAIL=admin@pmp.web.id
ADMIN_PASSWORD=ubah-saya

# --- Aplikasi ---
APP_NAME=learning-management
PORT=3360
HOST=127.0.0.1
PUBLIC_BASE_URL=https://lms.pmp.web.id
SPA_DIR=D:\apps\learning-management\public
# Jalur zite.schema.json — sumber nama tabel & kolom untuk runtime.
LMS_SCHEMA_PATH=D:\apps\learning-management\zite.schema.json
BODY_LIMIT=40mb

# --- Penyimpanan (data besar wajib di E:) ---
UPLOADS_DIR=E:\Data\Application\learning-management\uploads
PDF_DIR=E:\Data\Application\learning-management\pdf
MAX_UPLOAD_BYTES=26214400

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

# --- AI (opsional) ---
# Nama variabel dipertahankan kerena dibaca langsung oleh src/server/ai.ts.
ZITE_ANTHROPIC_ACCESS_TOKEN=

# --- Frontend (dipakai saat `vite build`) ---
# Kosongkan bila SPA dilayani satu origin dengan API.
VITE_API_BASE_URL=
